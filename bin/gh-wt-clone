#!/usr/bin/env bash
# gh-wt-clone: Clone a GitHub/GHE repo as a bare repo with proper worktree support.
#
# Usage: gh-wt-clone [--host <hostname>] [--org] <owner/repo | repo | url> [<target-dir>]
#
# <target-dir> defaults to '.' and must already exist.  Creates:
#   <target-dir>/<reponame>/<reponame>.git/     bare repo with correct fetch refspecs
#   <target-dir>/<reponame>/<default-branch>/   linked worktree for the default branch
# With --org, <owner>/ is inserted after <target-dir>.
#
# Resolves the SSH clone URL (and, for forks, the parent) via 'gh', then hands
# off to git-wt-clone, which must live alongside this script.
#
# GH_HOST env var is respected if --host is not given.

set -euo pipefail

GH_HOST="${GH_HOST:-github.com}"
_org_flag=()

usage_full() {
    cat >&2 <<'EOF'
Usage: gh-wt-clone [--host <hostname>] [--org] <owner/repo | repo | url> [<target-dir>]

Options:
  --host <hostname>  GitHub host (default: $GH_HOST or github.com)
  --org              Insert the owner: clone into <target-dir>/<owner>/<repo>/
  --help             Show this help and exit
  -h, -?             Show brief usage and exit

Clones into <target-dir>/<repo>/<repo>.git and adds a worktree for the
default branch at <target-dir>/<repo>/<default-branch>.  <target-dir>
defaults to the current directory and must already exist.  Forks also get an
'upstream' remote pointing at the parent repo.
EOF
    exit 0
}

usage_brief() {
    echo "Usage: gh-wt-clone [--host <hostname>] [--org] <owner/repo | repo | url> [<target-dir>]" >&2
    exit 0
}

while [[ $# -gt 0 && "$1" == -* ]]; do
    case "$1" in
        --host)   GH_HOST="$2"; shift 2 ;;
        --org)    _org_flag=(--org); shift ;;
        --help)   usage_full ;;
        -h | -\?) usage_brief ;;
        *) echo "gh-wt-clone: unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ $# -lt 1 ]]; then
    echo "gh-wt-clone: missing <owner/repo> argument" >&2
    exit 1
fi

_repo="$1"
_target_dir="${2:-.}"

# Resolve symlinks so an install that links only this script into ~/bin still
# finds the real sibling.
_self=$(readlink -f "${BASH_SOURCE[0]}")
_git_wt_clone="$(dirname "${_self}")/git-wt-clone"

if [[ ! -d "${_target_dir}" ]]; then
    echo "gh-wt-clone: target directory does not exist: ${_target_dir}" >&2
    exit 1
fi

export GH_HOST

# Fetch all relevant repo metadata in a single API call
_repo_json=$(gh repo view "${_repo}" --json isFork,sshUrl,parent)
_is_fork=$(printf '%s' "${_repo_json}" | jq -r '.isFork')
_clone_url=$(printf '%s' "${_repo_json}" | jq -r '.sshUrl')

# For forks, add the parent as 'upstream'.
_upstream_flag=()
if [[ "${_is_fork}" == "true" ]]; then
    _parent_owner=$(printf '%s' "${_repo_json}" | jq -r '.parent.owner.login')
    _parent_name=$(printf '%s' "${_repo_json}" | jq -r '.parent.name')
    # Construct SSH URL from host/owner/name rather than relying on parent.sshUrl
    # (not always present in the JSON payload across different GHE versions).
    _upstream_flag=(--upstream "git@${GH_HOST}:${_parent_owner}/${_parent_name}.git")
fi

exec "${_git_wt_clone}" "${_org_flag[@]}" "${_upstream_flag[@]}" "${_clone_url}" "${_target_dir}"
